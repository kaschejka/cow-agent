# Скопируйте этот файл в .env и подставьте свои значения.
# Переменные можно также задавать через переменные окружения — .env имеет более высокий приоритет.

# === База данных (MySQL) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cows
DB_USER=root
DB_PASS=

# === Redis (список хостов через запятую — используется первый доступный) ===
REDIS_HOSTS=127.0.0.1
REDIS_PORT=6379

# === Авторизация ===
# VK OAuth: получите на https://dev.vk.com (пустые значения = вход через VK отключён)
VK_APP_ID=
VK_APP_SECRET=
# Точный redirect_uri для OAuth VK, напр. https://example.com/
# (должен совпадать с адресом, указанным в настройках приложения на dev.vk.com).
# Пусто = вычисляется из текущего адреса страницы.
VK_REDIRECT_URI=
# Время жизни сессии, сек (по умолчанию 30 дней)
AUTH_SESSION_TTL=2592000

# === Почта (подтверждение регистрации) ===
# Базовый URL для ссылок в письмах; пусто = определяется из запроса автоматически
APP_URL=
# SMTP-сервер. Пустой SMTP_HOST = письма не отправляются (dev-режим, только лог)
SMTP_HOST=
SMTP_PORT=587
# ssl | tls (STARTTLS) | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Еноты-агенты
